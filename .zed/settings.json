{
  "languages": {
    "Python": {
      "language_servers": [
        "pyrefly",
        "ruff",
        "!basedpyright",
        "!pyright"
      ],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "ruff",
          "arguments": ["format", "--stdin-filename", "{buffer_path}", "-"]
        }
      },
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true
      }
    }
  }
}
