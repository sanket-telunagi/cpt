{
  "languages": {
    "Python": {
      "language_servers": [
        "pyrefly",
        "ruff",
        "!basedpyright",
        "!pyright"
      ],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "code_actions_on_save": {
        "source.organizeImports": true,
        "source.fixAll": true
      }
    }
  }
}
